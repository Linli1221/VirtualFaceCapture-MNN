<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Camera permission for face tracking -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 浏览器输出（OBS 浏览器源）：在本机监听 HTTP / WebSocket，供局域网内浏览器访问 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 支持前置 / 后置 / 外接（USB）摄像头：任意摄像头即可运行，具体朝向均为可选能力 -->
    <uses-feature android:name="android.hardware.camera.any" android:required="true" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    <uses-feature android:name="android.hardware.camera.external" android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher_gpt"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_gpt"
        android:supportsRtl="true"
        android:theme="@style/Theme.Live2DFacePipeline">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Live2DFacePipeline">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>