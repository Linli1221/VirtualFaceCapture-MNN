<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Camera permission for face tracking -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 局域网追踪数据输出：手机在本机监听 HTTP(8765) / WebSocket(/ws)，供 PC 客户端连接 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 支持前置 / 后置 / 外接（USB）摄像头：任意摄像头即可运行，具体朝向均为可选能力 -->
    <uses-feature android:name="android.hardware.camera.any" android:required="true" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    <uses-feature android:name="android.hardware.camera.external" android:required="false" />

    <application
        android:name=".VfcApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher_gpt"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_gpt"
        android:supportsRtl="true"
        android:theme="@style/Theme.VirtualFaceCapture">
        <!--
            横屏支持：
            - screenOrientation="sensor"：竖屏 + 左右横屏都允许（不受系统自动旋转开关
              影响，手机架在横屏支架上时也能用；不会倒转成倒竖屏）。
            - configChanges：旋转时 Activity 不重建，面捕管线 / 相机 session / 预览不中断。
              Camera2Manager 每帧读取 display.rotation，帧会自动旋转成新方向；
              布局（控制面板高度 / 摄像头选择列表）按 LocalConfiguration 自适应。
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="sensor"
            android:theme="@style/Theme.VirtualFaceCapture">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>